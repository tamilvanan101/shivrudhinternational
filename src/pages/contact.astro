---
import Base from '../layouts/Base.astro';
---

<Base title="Contact — Shivrudh International" description="Get in touch with Shivrudh International, Tamil Nadu spice and agri exporters.">
  <section class="border-b border-spice-100 bg-spice-800 text-cream-50">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h1 class="font-serif text-4xl font-bold">Contact us</h1>
      <p class="mt-3 max-w-2xl text-cream-200">
        We&rsquo;d love to hear about your requirement. Reach out and we&rsquo;ll respond promptly.
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-5 py-16 md:grid-cols-2">
    <div class="space-y-6">
      <div class="flex gap-4">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-spice-100 text-xl">📍</span>
        <div>
          <h2 class="font-semibold text-spice-800">Location</h2>
          <p class="mt-1 text-spice-600">Tamil Nadu, India</p>
        </div>
      </div>
      <div class="flex gap-4">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-spice-100 text-xl">✉️</span>
        <div>
          <h2 class="font-semibold text-spice-800">Email</h2>
          <p class="mt-1">
            <a href="mailto:info@shivrudhinternational.com" class="text-spice-600 hover:text-gold-600">
              info@shivrudhinternational.com
            </a>
          </p>
        </div>
      </div>
      <div class="flex gap-4">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-spice-100 text-xl">📝</span>
        <div>
          <h2 class="font-semibold text-spice-800">Enquiries</h2>
          <p class="mt-1 text-spice-600">
            For product enquiries, please
            <a href="/quote" class="font-semibold text-spice-700 hover:text-gold-600">request a quote</a>.
          </p>
        </div>
      </div>
    </div>

    <div class="rounded-3xl bg-spice-50 p-8">
      <h2 class="font-serif text-xl font-semibold text-spice-800">Ready to order?</h2>
      <p class="mt-3 text-spice-600">
        The fastest way to get pricing is to send us the product, quantity and
        destination through our quote form.
      </p>
      <a href="/quote" class="mt-6 inline-block rounded-lg bg-gold-500 px-6 py-3 font-semibold text-spice-900 transition hover:bg-gold-400">
        Request a Quote
      </a>
    </div>
  </section>
</Base>
