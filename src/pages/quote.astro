---
import Base from '../layouts/Base.astro';
import { PRODUCTS } from '../data/products';

// Prefill the product dropdown if the user arrived from a product page
// (e.g. /quote?product=Turmeric).
const preselected = Astro.url.searchParams.get('product') ?? '';
---

<Base title="Request a Quote — Shivrudh International" description="Request a quote for jasmine, turmeric and Tamil Nadu spices. Tell us the product, quantity and destination.">
  <section class="border-b border-spice-100 bg-spice-800 text-cream-50">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h1 class="font-serif text-4xl font-bold">Request a Quote</h1>
      <p class="mt-3 max-w-2xl text-cream-200">
        Share a few details and our team will respond with specifications,
        pricing and lead time. No obligation.
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-12 px-5 py-16 lg:grid-cols-3">
    <!-- Form -->
    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="lg:col-span-2 space-y-5"
    >
      <!-- Web3Forms: replace with your own access key from https://web3forms.com (free) -->
      <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
      <input type="hidden" name="subject" value="New quote request — Shivrudh International" />
      <input type="hidden" name="from_name" value="Shivrudh International Website" />
      <!-- Honeypot spam trap -->
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="name" class="block text-sm font-semibold text-spice-700">Your name *</label>
          <input
            id="name" name="name" type="text" required
            class="mt-1.5 w-full rounded-lg border border-spice-200 bg-white px-3.5 py-2.5 text-spice-800 outline-none focus:border-spice-500 focus:ring-2 focus:ring-spice-200"
          />
        </div>
        <div>
          <label for="company" class="block text-sm font-semibold text-spice-700">Company</label>
          <input
            id="company" name="company" type="text"
            class="mt-1.5 w-full rounded-lg border border-spice-200 bg-white px-3.5 py-2.5 text-spice-800 outline-none focus:border-spice-500 focus:ring-2 focus:ring-spice-200"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-semibold text-spice-700">Email *</label>
          <input
            id="email" name="email" type="email" required
            class="mt-1.5 w-full rounded-lg border border-spice-200 bg-white px-3.5 py-2.5 text-spice-800 outline-none focus:border-spice-500 focus:ring-2 focus:ring-spice-200"
          />
        </div>
        <div>
          <label for="country" class="block text-sm font-semibold text-spice-700">Destination country</label>
          <input
            id="country" name="country" type="text"
            class="mt-1.5 w-full rounded-lg border border-spice-200 bg-white px-3.5 py-2.5 text-spice-800 outline-none focus:border-spice-500 focus:ring-2 focus:ring-spice-200"
          />
        </div>
        <div>
          <label for="product" class="block text-sm font-semibold text-spice-700">Product of interest</label>
          <select
            id="product" name="product"
            class="mt-1.5 w-full rounded-lg border border-spice-200 bg-white px-3.5 py-2.5 text-spice-800 outline-none focus:border-spice-500 focus:ring-2 focus:ring-spice-200"
          >
            <option value="">Select a product</option>
            {
              PRODUCTS.map((p) => (
                <option value={p.name} selected={p.name === preselected}>
                  {p.name}
                </option>
              ))
            }
            <option value="Other" selected={preselected === 'Other'}>Other / multiple</option>
          </select>
        </div>
        <div>
          <label for="quantity" class="block text-sm font-semibold text-spice-700">Estimated quantity</label>
          <input
            id="quantity" name="quantity" type="text" placeholder="e.g. 2 x 20ft container"
            class="mt-1.5 w-full rounded-lg border border-spice-200 bg-white px-3.5 py-2.5 text-spice-800 outline-none focus:border-spice-500 focus:ring-2 focus:ring-spice-200"
          />
        </div>
      </div>

      <div>
        <label for="message" class="block text-sm font-semibold text-spice-700">Message</label>
        <textarea
          id="message" name="message" rows="5"
          placeholder="Tell us about your requirement — grade, packaging, target specs, delivery terms..."
          class="mt-1.5 w-full rounded-lg border border-spice-200 bg-white px-3.5 py-2.5 text-spice-800 outline-none focus:border-spice-500 focus:ring-2 focus:ring-spice-200"
        ></textarea>
      </div>

      <button
        type="submit"
        class="rounded-lg bg-gold-500 px-7 py-3 font-semibold text-spice-900 shadow-sm transition hover:bg-gold-400"
      >
        Send Request
      </button>
      <p class="text-xs text-spice-500">
        We respect your privacy. Your details are used only to respond to this enquiry.
      </p>
    </form>

    <!-- Sidebar -->
    <aside class="space-y-6">
      <div class="rounded-2xl border border-spice-100 bg-spice-50 p-6">
        <h2 class="font-serif text-lg font-semibold text-spice-800">What happens next</h2>
        <ol class="mt-4 space-y-3 text-sm text-spice-700">
          <li class="flex gap-3"><span class="font-bold text-gold-600">1.</span> We review your requirement and confirm availability.</li>
          <li class="flex gap-3"><span class="font-bold text-gold-600">2.</span> You receive specifications, pricing and lead time.</li>
          <li class="flex gap-3"><span class="font-bold text-gold-600">3.</span> We arrange samples and finalise terms.</li>
        </ol>
      </div>
      <div class="rounded-2xl border border-spice-100 bg-white p-6">
        <h2 class="font-serif text-lg font-semibold text-spice-800">Prefer email?</h2>
        <p class="mt-2 text-sm text-spice-600">
          Write to us directly at
          <a href="mailto:info@shivrudhinternational.com" class="font-semibold text-spice-700 hover:text-gold-600">info@shivrudhinternational.com</a>
        </p>
      </div>
    </aside>
  </section>
</Base>
